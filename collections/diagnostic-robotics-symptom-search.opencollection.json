              },
              {
                "name": "sex",
                "value": "",
                "type": "query",
                "description": "Biological sex of the patient, required for demographic specific symptoms"
              }
            ]
          },
          "docs": "autocomplete  search term for a prefix or partial term"
        }
      ]
    },
    {
      "info": {
        "name": "Visits",
        "type": "folder"
      },
      "items": [
